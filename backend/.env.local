# Local Development Environment Configuration

# Database configuration for MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=my_database

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_SECRET=my_jwt_secret

# BullMQ settings for local development
BULLMQ_REDIS_URL=redis://localhost:6379