# Node Environment
NODE_ENV=development
PORT=3000

# Database - MariaDB
DATABASE_URL=mysql://etl_user:etl_password@localhost:3306/etl_db
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2

# Database - SQLite Fallback
SQLITE_URL=file:./dev.db

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Upstash Redis (Production Cache)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# BullMQ Configuration
BULLMQ_QUEUE_NAME=etl-jobs
BULLMQ_CONCURRENCY=10
BULLMQ_MAX_ATTEMPTS=3

# qStash Configuration (Fallback Worker Queue)
QSTASH_TOKEN=your_qstash_token
QSTASH_URL=https://qstash.io

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRE=7d

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000

# ETL Configuration
ETL_MAX_FILE_SIZE=104857600
ETL_ALLOWED_EXTENSIONS=csv,json,xlsx,xml
ETL_BATCH_SIZE=1000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password